{
  "info": {
    "name": "RideLink - Driver & Vehicle Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order: Happy path, Negative scenarios, Cleanup."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "driverId",
      "value": ""
    },
    {
      "key": "vehicleId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 Happy path",
      "item": [
        {
          "name": "01 Create driver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"acc-{{runId}}\",\n  \"name\": \"Nimal Perera\",\n  \"phone\": \"0771234567\",\n  \"licenseNumber\": \"LIC-{{runId}}\",\n  \"serviceArea\": \"Colombo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"driverId\", pm.response.json().id);",
                  "pm.test(\"starts UNAVAILABLE\", function () { pm.expect(pm.response.json().availabilityStatus).to.eql(\"UNAVAILABLE\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Create vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driverId}}\",\n  \"vehicleNumber\": \"CAB-{{runId}}\",\n  \"vehicleType\": \"CAR\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Prius\",\n  \"color\": \"White\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"vehicleId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Set driver location",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driverId}}",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 6.9271,\n  \"longitude\": 79.8612\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Set service area",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/service-area",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driverId}}",
                "service-area"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceArea\": \"Colombo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Set driver AVAILABLE",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driverId}}",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availabilityStatus\": \"AVAILABLE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"is AVAILABLE\", function () { pm.expect(pm.response.json().availabilityStatus).to.eql(\"AVAILABLE\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Available drivers by service area",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/available?serviceArea=Colombo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "available"
              ],
              "query": [
                {
                  "key": "serviceArea",
                  "value": "Colombo"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"list not empty\", function () { pm.expect(pm.response.json().length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Available drivers by coordinates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/available?latitude=6.9271&longitude=79.8612",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "available"
              ],
              "query": [
                {
                  "key": "latitude",
                  "value": "6.9271"
                },
                {
                  "key": "longitude",
                  "value": "79.8612"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Get driver",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driverId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Update driver",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driverId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nimal Perera\",\n  \"phone\": \"0779876543\",\n  \"licenseNumber\": \"LIC-{{runId}}\",\n  \"serviceArea\": \"Colombo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Get driver's vehicles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/vehicles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driverId}}",
                "vehicles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Get vehicle",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles",
                "{{vehicleId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Negative scenarios",
      "item": [
        {
          "name": "N1 Invalid driver ID -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "does-not-exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"error code\", function () { pm.expect(pm.response.json().error).to.eql(\"DRIVER_NOT_FOUND\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "N2 Duplicate vehicle number -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driverId}}\",\n  \"vehicleNumber\": \"CAB-{{runId}}\",\n  \"vehicleType\": \"CAR\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Prius\",\n  \"color\": \"White\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"error code\", function () { pm.expect(pm.response.json().error).to.eql(\"DUPLICATE_VEHICLE\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "N3 Invalid input (blank fields) -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"\",\n  \"name\": \"\",\n  \"phone\": \"\",\n  \"licenseNumber\": \"\",\n  \"serviceArea\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"has field details\", function () { pm.expect(pm.response.json().details).to.have.property(\"name\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "N4 Invalid latitude -> 400",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driverId}}",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 95,\n  \"longitude\": 79.8612\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "N5 Invalid vehicleType -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driverId}}\",\n  \"vehicleNumber\": \"BUS-1\",\n  \"vehicleType\": \"BUS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "N6 Only latitude sent -> 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/available?latitude=6.9271",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "available"
              ],
              "query": [
                {
                  "key": "latitude",
                  "value": "6.9271"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "N7 Duplicate driver (same accountId) -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"acc-{{runId}}\",\n  \"name\": \"Other\",\n  \"phone\": \"0770000000\",\n  \"licenseNumber\": \"LIC-OTHER-{{runId}}\",\n  \"serviceArea\": \"Colombo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 Cleanup",
      "item": [
        {
          "name": "C1 Delete vehicle -> 204 (driver becomes UNAVAILABLE)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "vehicles",
                "{{vehicleId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "C2 Delete driver -> 204",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driverId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}