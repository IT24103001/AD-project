# Copy to .env and replace the placeholders. NEVER commit .env
MONGODB_URI=mongodb://localhost:27017/ridelink_account_db
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=3600000
SERVER_PORT=8081
# Optional first admin (created at startup if the email does not exist yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
